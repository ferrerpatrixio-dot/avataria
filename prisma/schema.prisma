// AVATARIA - AI Avatar Project Management System
// LEIA: Fútbol + MMA + Música + Cine + Psicología — Mercados MX, CL, ES

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String   @default("AVATARIA")
  avatarName  String   @default("Leia")
  description String?
  currentPhase String  @default("0")
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  phases     Phase[]
  scripts    Script[]
  contents   Content[]
  budgets    Budget[]
  decisions  Decision[]
}

model Phase {
  id          String   @id @default(cuid())
  projectId   String
  phaseNumber Int
  title       String
  description String?
  status      String   @default("pending")
  startDate   DateTime?
  endDate     DateTime?
  budgetMin   Float    @default(0)
  budgetMax   Float    @default(0)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project  Project    @relation(fields: [projectId], references: [id])
  tasks    PhaseTask[]
  decisions Decision[]
}

model PhaseTask {
  id          String   @id @default(cuid())
  phaseId     String
  title       String
  description String?
  status      String   @default("pending")
  order       Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  phase Phase @relation(fields: [phaseId], references: [id])
}

model Decision {
  id        String   @id @default(cuid())
  phaseId   String?
  projectId String
  title     String
  criteria  String?
  decision  String?
  notes     String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  project Project @relation(fields: [projectId], references: [id])
  phase   Phase?   @relation(fields: [phaseId], references: [id])
}

model Script {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  type        String
  content     String
  duration    String?
  tone        String   @default("sarcastico_mexicano")
  variation   Int?
  status      String   @default("draft")
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project  Project   @relation(fields: [projectId], references: [id])
  contents Content[]
}

model Content {
  id            String   @id @default(cuid())
  projectId     String
  scriptId      String?
  title         String
  type          String
  status        String   @default("planned")
  platform      String?
  imageUrl      String?
  videoUrl      String?
  prompt        String?
  notes         String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  project Project @relation(fields: [projectId], references: [id])
  script  Script?  @relation(fields: [scriptId], references: [id])
  metrics Metric[]
}

model Metric {
  id         String   @id @default(cuid())
  contentId  String
  platform   String?
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  saves      Int      @default(0)
  clicks     Int      @default(0)
  followers  Int      @default(0)
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  
  content Content @relation(fields: [contentId], references: [id])
}

model Budget {
  id            String   @id @default(cuid())
  projectId     String
  category      String
  description   String?
  plannedAmount Float    @default(0) // Presupuesto estimado para esta herramienta
  amount        Float    @default(0) // Gasto REAL — solo cuando se gasta de verdad
  currency      String   @default("USD")
  spentAt       DateTime? // Fecha real del gasto (null si aún no se ha gastado)
  createdAt     DateTime @default(now())
  
  project Project @relation(fields: [projectId], references: [id])
}